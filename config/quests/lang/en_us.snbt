	reward.58B95F1D8C91FB48.title: "Bane of Arthropods"
	reward.5992BCB73C348F8A.title: "Efficiency"
	reward.5F71F8808B460010.title: "Smite"
	reward.68D87F57E1782729.title: "Looting"
	reward.6B1F4629D26E21E5.title: "Power"
	reward.6B706DABDA235A0B.title: "Density"
	reward.739EFC4F05F9136E.title: "Backstabbing"
